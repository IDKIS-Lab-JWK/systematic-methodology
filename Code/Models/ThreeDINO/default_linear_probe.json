{
  "schema_version": 1,
  "method": "linear_probe",
  "profile_type": "practical_default",
  "source": {
    "starting_point": "3DINO frozen linear-classification protocol",
    "paper_url": "https://www.nature.com/articles/s41746-025-02035-w",
    "official_repository": "https://github.com/AICONSlab/3DINO",
    "repository_revision": "85bd4435c1b2ada41cd34cd15cad17c4d3c88d89",
    "checkpoint": "AICONSlab/3DINO-ViT",
    "provenance_note": "This single-head profile is a resource-conscious project default for the present five-class dataset. It is not a parameter set reported by the 3DINO publication."
  },
  "task_adaptations": {
    "publication_exact": false,
    "class_order": [
      "Appendicitis",
      "Cholezystitis",
      "Normal",
      "Perforation",
      "Sigmoid"
    ],
    "selection_policy": "five development folds only; evaluate the fixed held-out set after the profile and model source are fixed"
  },
  "parameters": {
    "optimizer": "sgd",
    "lr": 0.00125,
    "nominal_lr": 0.01,
    "learning_rate_scale_rule": "global_batch_over_256",
    "momentum": 0.9,
    "weight_decay": 0.0,
    "scheduler": "cosine",
    "scheduler_eta_min": 0.0,
    "batch_size": 32,
    "max_iterations": 12500,
    "evaluation_interval_iterations": 50,
    "n_last_blocks": 4,
    "use_mean_patch_token": true,
    "feature_dim": 5120,
    "encoder_frozen": true,
    "loss": "cross_entropy",
    "class_weighting": "none",
    "input_shape_dhw": [
      112,
      112,
      112
    ],
    "resize_prefix_shape_dhw": [
      144,
      144,
      112
    ],
    "seed": 42
  }
}
